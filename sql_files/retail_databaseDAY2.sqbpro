<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="retail_database.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1366"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="retail_sales" custom_title="0" dock_id="1" table="4,12:mainretail_sales"/><dock_state state="000000ff00000000fd0000000100000002000005f4000002acfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f40000012500ffffff0000026c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="retail_sales" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="51"/><column index="2" value="124"/><column index="3" value="70"/><column index="4" value="78"/><column index="5" value="85"/><column index="6" value="59"/><column index="7" value="70"/><column index="8" value="114"/><column index="9" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Create a CTE that calculates total revenue for each city, then display all cities.

WITH city_revenue as (

SELECT city, sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by city)

SELECT *
FROM city_revenue;


-- Management wants to identify products that sold more than 5 units in total.

WITH product_quantity as(

SELECT product_name,sum(quantity) as total_quantity
FROM retail_sales
GROUP by product_name)


SELECT *
FROM product_quantity
where total_quantity &gt; 5;



-- The pricing team wants to know which product categories have an average selling price above ₹1500.

WITH category_avg_price as(

SELECT category,avg(unit_price) as avg_item_price
FROM retail_sales
GROUP by category)


SELECT category,round(avg_item_price,2) as avg_item_price
FROM category_avg_price
where avg_item_price &gt; 1500;


-- the sales manager wants to see total revenue generated by each product after discounts.

WITH product_revenue as(

SELECT product_name,sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by product_name)

SELECT *
FROM product_revenue
order by total_revenue desc;



-- The operations team wants to know which cities generated more than three sales transactions.

WITH city_sale_count as (

SELECT city,count(sale_id) as sale_count
FROM retail_sales
GROUP by city)


SELECT *
FROM city_sale_count
WHERE sale_count &gt;3;


-- The marketing team wants to identify categories offering higher-than-average discounts.

SELECT 	category,discount_percent
FROM retail_sales
WHERE discount_percent &gt; (SELECT avg(discount_percent) as avg_discount FROM retail_sales);


-- Finance wants to review monthly revenue performance.


SELECT strftime(&quot;%m&quot;,sale_date) as month,sum(quantity*unit_price*(1-discount_percent/100)) as revenue
FROM retail_sales
group by month;


-- Which product category generated the highest revenue?
WITH category_revenue as (

SELECT category,sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by category)


SELECT *
FROM category_revenue
WHERE total_revenue = (SELECT max(total_revenue) FROM category_revenue);


-- Which cities have an average quantity sold greater than the company-wide average quantity per city?

with city_quantity as (

SELECT city,avg(quantity) as avg_quantity
FROM retail_sales
GROUP by city)


SELECT * 
FROM city_quantity 
where avg_quantity &gt; (SELECT avg(avg_quantity) FROM city_quantity);


-- The business wants to know the total revenue generated by each city after discounts.

with city_revenue as(

SELECT city,sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by city)

SELECT *
FROM city_revenue
ORDER by total_revenue desc;



-- The regional manager wants to identify cities performing above the average city revenue.
with city_revenue as(

SELECT city,sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by city)

SELECT *
FROM city_revenue
where total_revenue &gt; ( SELECT avg(total_revenue) from city_revenue);



-- Find the products generating the highest total revenue.

WITH product_revenue as(

SELECT product_name,sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by product_name)

SELECT *
FROM product_revenue
WHERE total_revenue = (SELECT max(total_revenue) FROM product_revenue);


-- Which categories generate above-average revenue per transaction?

WITH category_revenue as(

SELECT category,avg(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by category)

SELECT *
FROM category_revenue
where total_revenue &gt; (SELECT avg(total_revenue) FROM category_revenue);



-- Finance wants to know which months performed above the average monthly revenue.


with monthly_revenue as(

SELECT strftime(&quot;%m&quot;,sale_date) as month,sum(quantity*unit_price*(1-discount_percent/100)) as total_revenue
FROM retail_sales
GROUP by month )


SELECT *
FROM monthly_revenue
where total_revenue &gt; (SELECT avg(total_revenue) FROM monthly_revenue);



-- Inventory management wants to identify products selling above the average product quantity.


WITH product_quantity as(

SELECT product_name,sum(quantity) as total_quantity
FROM retail_sales
GROUP by product_name)


SELECT *
FROM product_quantity 
where total_quantity &gt; (SELECT avg(total_quantity) FROM product_quantity);


-- The business wants a report showing every city's revenue contribution compared with the company's average city revenue.

WITH city_revenue as (
SELECT city,sum(quantity*unit_price*discount_percent) as total_revenue
FROM retail_sales
GROUP by city)

SELECT city,total_revenue,(SELECT avg(total_revenue) FROM city_revenue) as avg_total_revenue,round(total_revenue/(SELECT avg(total_revenue) FROM city_revenue)*100,2) as contribution
 
FROM city_revenue
group by city;</sql><current_tab id="0"/></tab_sql></sqlb_project>
