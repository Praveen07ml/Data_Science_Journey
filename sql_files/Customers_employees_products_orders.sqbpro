 index="2" value="86"/><column index="3" value="76"/><column index="4" value="75"/><column index="5" value="55"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="74"/><column index="2" value="96"/><column index="3" value="61"/><column index="4" value="38"/><column index="5" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">


-- connectig three tables together

SELECT c.customer_name,p.product_name,o.order_date,o.amount
from orders o
JOIN customers c on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id;


-- Total revenue by product category


SELECT p.category,sum(o.amount) as total_revenue
FROM orders o
JOIN products p
on o.product_id = p.product_id
GROUP by p.category
ORDER by total_revenue DESC;


-- Which customer spent most on Electronics

SELECT c.customer_name,sum(o.amount) as total_amount
FROM orders o
JOIN customers c on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
WHERE p.category = &quot;Electronics&quot;
GROUP by c.customer_name
ORDER by total_amount DESC;


--  How many orders per product

SELECT p.product_name,count(o.order_id) as order_count
FROM orders o
JOIN products p
on o.product_id = p.product_id
GROUP by p.product_name
ORDER by order_count DESC;


-- City wise revenue by category


SELECT c.city,p.category,sum(o.amount) as revenue 
FROM orders o
JOIN customers c on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id
GROUP by c.city,p.category
ORDER by revenue desc;



--Show every employee with their manager name

SELECT e.employee_name as employee, m.employee_name as manager
FROM employees e
LEFT JOIN employees m
on e.manager_id = m.employee_id;

--Show only employees who have a manager

SELECT e.employee_name as employee_name,m.employee_name as manager_name
FROM employees e
JOIN employees m
on e.manager_id = m.employee_id;


-- Show managers and how many people report to them

SELECT m.employee_name as manager_name,count(e.employee_name) as report_count
FROM employees m
JOIN employees e
on m.manager_id = e.employee_id
group by m.employee_name;





SELECT c.customer_name,p.product_name,p.category,p.price
FROM products p
left JOIN orders o
on p.product_id = o.product_id
LEFT JOIN customers c
on o.customer_id = c.customer_id; 


-- Challenge 2 — Find products that have never been ordered at all.

SELECT p.product_name,o.order_id
FROM products p
LEFT JOIN orders o
on p.product_id = o.product_id
where o.order_id is NULL;


-- Challenge 3 — Show customer name, city, product name, category, amount for all orders. Three table JOIN with all columns.

SELECT c.customer_name,c.city,p.product_name,p.category,o.amount 
FROM orders o
JOIN customers c on o.customer_id = c.customer_id
JOIN products p on o.product_id = p.product_id;



-- Challenge 4 — Which city generated most revenue from Electronics category only?


SELECT c.city,sum(o.amount) as revenue,p.category
FROM customers c
JOIN orders o
on c.customer_id = o.customer_id
JOIN products p
on o.product_id = p.product_id
WHERE p.category = &quot;Electronics&quot;
GROUP by c.city,p.category
ORDER by revenue DESC;


-- Show each customer, their total orders, total spending, and average order value. Include customers with zero orders showing 0 for all three.



SELECT c.customer_name,count(o.order_id) as total_orders,ifnull(sum(o.amount),0) as total_spend,coalesce(avg(o.amount),0) as avg_order_value
FROM customers c
left JOIN orders o
on c.customer_id = o.customer_id
GROUP by c.customer_name
order by total_orders desc,total_spend desc;


-- Challenge 6 — Find employees who earn more than their manager using SELF JOIN.

SELECT e.employee_name as employee,m.employee_name as manager,e.salary
FROM employees e
JOIN employees m
on e.manager_id = m.employee_id
where e.salary &gt; m.salary;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
